rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas permanentes de producción para Chefcita (Sin fecha de vencimiento de 30 días)
    match /insumos/{docId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.nombre is string
                            && request.resource.data.nombre.size() > 0;
    }

    match /recetas/{docId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.nombre is string
                            && request.resource.data.nombre.size() > 0;
    }

    match /pedidos/{docId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.cliente_nombre is string
                            && request.resource.data.cliente_nombre.size() > 0;
    }
  }
}
